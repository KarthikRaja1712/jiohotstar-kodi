<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<settings version="1">
    <section id="plugin.video.jiohotstar">

        <category id="account" label="30100" help="">
            <group id="login" label="30101">
                <setting id="country_code" type="string" label="30110" help="">
                    <level>0</level>
                    <default>+91</default>
                    <constraints>
                        <allowempty>false</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30110</heading>
                    </control>
                </setting>
                <setting id="mobile_number" type="string" label="30111" help="">
                    <level>0</level>
                    <default></default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30111</heading>
                    </control>
                </setting>
                <setting id="login_action" type="action" label="30112" help="">
                    <level>0</level>
                    <data>RunPlugin(plugin://plugin.video.jiohotstar/?action=login)</data>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="button" format="action">
                        <close>true</close>
                    </control>
                </setting>
                <setting id="logout_action" type="action" label="30113" help="">
                    <level>0</level>
                    <data>RunPlugin(plugin://plugin.video.jiohotstar/?action=logout)</data>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="button" format="action">
                        <close>true</close>
                    </control>
                </setting>
            </group>
        </category>

        <category id="playback" label="30200" help="">
            <group id="streaming" label="30201">
                <setting id="stream_protocol" type="integer" label="30210" help="">
                    <level>0</level>
                    <default>0</default>
                    <constraints>
                        <options>
                            <option label="30211">0</option>
                            <option label="30212">1</option>
                        </options>
                    </constraints>
                    <control type="spinner" format="string"/>
                </setting>
                <setting id="max_resolution" type="integer" label="30213" help="">
                    <level>0</level>
                    <default>1080</default>
                    <constraints>
                        <options>
                            <option label="30214">0</option>
                            <option label="30215">2160</option>
                            <option label="30216">1080</option>
                            <option label="30217">720</option>
                            <option label="30218">480</option>
                        </options>
                    </constraints>
                    <control type="spinner" format="string"/>
                </setting>
                <setting id="prefer_hevc" type="boolean" label="30219" help="">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle"/>
                </setting>
                <setting id="audio_language" type="string" label="30220" help="">
                    <level>0</level>
                    <default>hin</default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30220</heading>
                    </control>
                </setting>
                <setting id="subtitle_language" type="string" label="30221" help="">
                    <level>0</level>
                    <default>eng</default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30221</heading>
                    </control>
                </setting>
            </group>
            <group id="drm" label="30202">
                <setting id="run_isa_helper" type="boolean" label="30222" help="">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="open_isa_settings" type="action" label="30223" help="">
                    <level>0</level>
                    <data>Addon.OpenSettings(inputstream.adaptive)</data>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="button" format="action">
                        <close>false</close>
                    </control>
                </setting>
            </group>
        </category>

        <category id="content" label="30300" help="">
            <group id="listings" label="30301">
                <setting id="items_per_page" type="integer" label="30310" help="">
                    <level>0</level>
                    <default>30</default>
                    <constraints>
                        <minimum>10</minimum>
                        <step>10</step>
                        <maximum>100</maximum>
                    </constraints>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                    </control>
                </setting>
                <setting id="content_languages" type="string" label="30311" help="">
                    <level>0</level>
                    <default>hi,en</default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30311</heading>
                    </control>
                </setting>
                <setting id="cache_minutes" type="integer" label="30312" help="">
                    <level>0</level>
                    <default>30</default>
                    <constraints>
                        <minimum>0</minimum>
                        <step>5</step>
                        <maximum>120</maximum>
                    </constraints>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                    </control>
                </setting>
                <setting id="clear_cache_action" type="action" label="30313" help="">
                    <level>0</level>
                    <data>RunPlugin(plugin://plugin.video.jiohotstar/?action=clear_cache)</data>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="button" format="action">
                        <close>false</close>
                    </control>
                </setting>
            </group>
        </category>

        <category id="advanced" label="30400" help="">
            <group id="diagnostics" label="30401">
                <setting id="debug_logging" type="boolean" label="30410" help="">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle"/>
                </setting>
                <setting id="request_timeout" type="integer" label="30411" help="">
                    <level>0</level>
                    <default>20</default>
                    <constraints>
                        <minimum>5</minimum>
                        <step>5</step>
                        <maximum>60</maximum>
                    </constraints>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                    </control>
                </setting>
                <setting id="reset_device_action" type="action" label="30412" help="">
                    <level>0</level>
                    <data>RunPlugin(plugin://plugin.video.jiohotstar/?action=reset_device)</data>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="button" format="action">
                        <close>false</close>
                    </control>
                </setting>
            </group>
        </category>

    </section>
</settings>
