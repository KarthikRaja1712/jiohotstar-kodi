<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.jiohotstar"
       name="JioHotstar Repository"
       version="1.0.0"
       provider-name="YourName">
    <requires>
        <import addon="xbmc.addon" version="12.0.0"/>
    </requires>
    <extension point="xbmc.addon.repository" name="JioHotstar Repository">
        <dir>
            <info compressed="false">https://KarthikRaja1712.github.io/jiohotstar-kodi/addons.xml</info>
            <checksum>https://KarthikRaja1712.github.io/jiohotstar-kodi/addons.xml.md5</checksum>
            <datadir zip="true">https://KarthikRaja1712.github.io/jiohotstar-kodi/zips/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">JioHotstar add-on repository</summary>
        <description lang="en_GB">Hosts updates for the unofficial JioHotstar Kodi add-on.</description>
        <platform>all</platform>
        <license>GPL-3.0-or-later</license>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
